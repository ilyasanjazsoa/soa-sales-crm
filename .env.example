# Copy to .env with `pnpm env:init`, which also generates the secrets below. Never commit .env.
# Variables are described in docs/API.md §Configuration.

NODE_ENV=development
# local | ci | staging | production. Staging refuses to start without MAIL_ALLOWLIST.
DEPLOY_ENV=local
LOG_LEVEL=info
PORT=3000
PUBLIC_URL=http://localhost:3000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# 32-byte secrets as 64 hex characters. Left blank on purpose: `pnpm env:init` fills them in your .env.
SESSION_SECRET=
TOKEN_ENC_KEY=
UNSUBSCRIBE_SECRET=
IP_HASH_SALT=

# Sign-in (DECISIONS.md decision 10: Microsoft). Client id, secret and tenant are needed only with FAKE_PROVIDERS=false.
IDP=microsoft
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT_ID=
ALLOWED_EMAIL_DOMAIN=soa.example
BOOTSTRAP_ADMIN_EMAIL=admin@soa.example

# AI through Amazon Bedrock. Real model ids come from DECISIONS.md item B; these placeholders are only used by the fakes.
AWS_REGION=us-east-1
AI_MODEL_WRITER=fake-writer
AI_MODEL_FAST=fake-fast

# File storage (MinIO locally; the bucket is created by docker compose).
S3_BUCKET=soa-crm-local
S3_ENDPOINT=http://localhost:9000

# Maps and e-signature. Needed only with FAKE_PROVIDERS=false (DECISIONS.md items C and D).
MAPS_PROVIDER=
MAPS_API_KEY=
ESIGN_PROVIDER=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
ESIGN_TEMPLATE_ID=

# Company details for the email footer and contracts (DECISIONS.md item F). Email sending is refused until the address is set.
COMPANY_NAME=Security Of America
COMPANY_POSTAL_ADDRESS=
COMPANY_SIGNER_NAME=
COMPANY_SIGNER_EMAIL=

# Staging only: comma-separated addresses mail may be sent to.
MAIL_ALLOWLIST=

# Local and CI: swap every external provider for its fake.
FAKE_PROVIDERS=true
